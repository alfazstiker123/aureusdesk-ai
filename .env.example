# Salin file ini menjadi .env.local untuk development lokal.
# Jangan commit file .env.local atau membagikan key rahasia.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Gemini - server-side
GEMINI_API_KEY=isi_api_key_gemini_anda
# APP_PIN=ganti_dengan_pin_kuat
# GEMINI_THINKING_BUDGET=1024
# USDJPY_RATE=155
# MT4_SERVER_UTC_OFFSET=2

# MT4 V2 - server-side only
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_supabase_staging
MT4_BRIDGE_SECRET=ganti_dengan_random_secret_panjang_minimal_32_karakter
# Mapping pair aplikasi ke nama symbol persis di Market Watch broker MT4
MT4_SYMBOL_MAP={"XAUUSD":"XAUUSDm","EURUSD":"EURUSD.a"}

# Optional: gateway OpenAI-compatible untuk mode 2 tahap V1
# OPENAI_COMPAT_API_KEY=...
# OPENAI_COMPAT_BASE_URL=https://provider.example/v1

# Cloud OHLC: GRATIS tanpa kunci (Kraken, cadangan Binance market-data). Saat ini hanya BTCUSD. Tidak perlu env var.
# Optional JSON overrides for provider-specific symbols, e.g. {"XAUUSD":"XAU/USD","BTCUSD":"BTC/USD"}
CLOUD_SYMBOL_MAP={}
